# — Apex Vouchers Environment (example) —
# Copy this file to .env and fill in real values. Never commit .env.

# Database
MONGODB_URI=

# JWT Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Client & Server URLs
CLIENT_URL=http://localhost:5173
PORT=5000
NODE_ENV=development

# Centralized Business & Support Details
BUSINESS_NAME=
BUSINESS_EMAIL=
SUPPORT_EMAIL=
SUPPORT_PHONE=
ADMIN_NOTIFICATION_EMAIL=

# Initial Admin Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Payment Provider (Cashfree)
PAYMENT_PROVIDER=cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# SMTP Email (transactional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# ==========================================
# SEO
# ==========================================
# Canonical/absolute site URL used for sitemap URLs, canonical tags and
# structured data. No external API keys or OAuth are required for SEO.
SEO_SITE_URL=https://apexvouchers.com
