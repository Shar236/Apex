# — Apex Vouchers Environment (example) —
# Copy this file to .env and fill in real values. Never commit .env.

# Database
MONGODB_URI=

# JWT Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Client & Server URLs
CLIENT_URL=http://localhost:5173
# Public base URL of THIS API (used to build the Razorpay webhook URL you paste
# into the Razorpay dashboard: <SERVER_URL>/api/payments/webhook).
SERVER_URL=http://localhost:5000
PORT=5000
NODE_ENV=development
# Comma-separated extra browser origins allowed by CORS (prod frontend domains).
CORS_EXTRA_ORIGINS=

# Centralized Business & Support Details
BUSINESS_NAME=
BUSINESS_EMAIL=
SUPPORT_EMAIL=
SUPPORT_PHONE=
ADMIN_NOTIFICATION_EMAIL=

# Initial Admin Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ==========================================
# Payment Provider — Razorpay
# ==========================================
PAYMENT_PROVIDER=razorpay
# Key ID is PUBLISHABLE — it is sent to the browser for Razorpay Checkout.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# Key Secret is SERVER-ONLY. Never expose it to the frontend, logs, or git.
RAZORPAY_KEY_SECRET=
# Webhook signing secret — set this to the value you configure in the Razorpay
# Dashboard → Settings → Webhooks. Subscribe to: payment.captured, payment.failed,
# order.paid. Webhook URL: <SERVER_URL>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=
# test | live
RAZORPAY_ENV=test

# SMTP Email (transactional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# ==========================================
# SEO
# ==========================================
# Canonical/absolute site URL used for sitemap URLs, canonical tags and
# structured data. No external API keys or OAuth are required for SEO.
SEO_SITE_URL=https://apexvouchers.com
