# — Apex Vouchers Environment (example) —
# Copy this file to .env and fill in real values. Never commit .env.

# Database
MONGODB_URI=

# JWT Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Client & Server URLs
CLIENT_URL=http://localhost:5173
PORT=5000
NODE_ENV=development

# Centralized Business & Support Details
BUSINESS_NAME=
BUSINESS_EMAIL=
SUPPORT_EMAIL=
SUPPORT_PHONE=
ADMIN_NOTIFICATION_EMAIL=

# Initial Admin Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Payment Provider (Cashfree)
PAYMENT_PROVIDER=cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# SMTP Email (transactional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# ==========================================
# GOOGLE SEO INTEGRATIONS (Phase 2)
# ==========================================
# Disabled by default. The app boots and the Blog CMS / SEO Manager work
# fully without any of these. Only flip *_ENABLED to "true" once you have
# supplied real values below — placeholder/empty values are treated as "not
# configured" and no live Google API call is ever attempted in that state.

# Master switch — must be "true" for either integration below to activate.
GOOGLE_SEO_INTEGRATION_ENABLED=false

# ------------------------------------------
# Google Search Console OAuth
# ------------------------------------------
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console,
# enable the "Google Search Console API", and add GOOGLE_OAUTH_REDIRECT_URI
# below as an authorized redirect URI on that OAuth client.
GOOGLE_SEARCH_CONSOLE_ENABLED=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/admin/seo/google/callback

# Encryption key used to encrypt the stored OAuth refresh token at rest.
# Generate a strong random value in production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ------------------------------------------
# Google PageSpeed Insights
# ------------------------------------------
# Create an API key in Google Cloud Console and enable the
# "PageSpeed Insights API" for it. This is a simple API key — no OAuth.
GOOGLE_PAGESPEED_ENABLED=false

GOOGLE_PAGESPEED_API_KEY=

# Canonical site URL used as the default Search Console property / PageSpeed target.
SEO_SITE_URL=https://apexvouchers.com
