{
  "name": "apex-voucher-workspace",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c magenta,cyan \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "seed": "npm --prefix backend run seed",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "install:all": "npm --prefix frontend install && npm --prefix backend install",
    "mcp": "node mcp-server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "mongodb": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
