# — Apex Vouchers Environment —
# Copy this file to .env (and .env in backend/) and fill values. Never commit .env

# Database
MONGODB_URI=mongodb+srv://<db_username>:Fjq9DDde0TfrkZME@apexcluster.adxjwp2.mongodb.net/apex_vouchers?retryWrites=true&w=majority&appName=apexcluster

# JWT Auth
JWT_SECRET=change_me_to_a_very_long_random_string_prod
JWT_EXPIRES_IN=7d

# Client & Server URLs
CLIENT_URL=http://localhost:5173
PORT=5000
NODE_ENV=development

# Initial Admin Credentials (used on first seed — create the admin)
ADMIN_EMAIL=admin@apexvouchers.in
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=System Admin

# Payment Provider (Cashfree Sandbox)
PAYMENT_PROVIDER=cashfree
CASHFREE_APP_ID=your_sandbox_app_id
CASHFREE_SECRET_KEY=your_sandbox_secret_key
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# SMTP Email (transactional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM="Apex Vouchers" <no-reply@apexvouchers.in>
SMTP_SECURE=false

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=nbcbpuql
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

